# Copy this file to .env.local and fill in your own value.
# Web3Forms access key — get one free at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key-here

# Cloudinary — used for unsigned client-side reference-image uploads on the
# cake order form. The image URL is included in the order email. Create a free
# account at https://cloudinary.com, then:
#   Cloud name:    Settings > Product environment (top of dashboard)
#   Upload preset: Settings > Upload > Upload presets > add an *unsigned* preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
